#!/usr/bin/env zsh

#	Third party plugins
#	------------------------------------------------------------------------
#	Cloned into ${ZSH_PLUGIN_DIR} by scripts/zsh_*.zsh via bootstrap.sh.
#	zsh-completions is not sourced: it only ships completion functions, and
#	S28_compinit already put its src/ directory on $fpath.
#
#	Order is load-bearing: zsh-syntax-highlighting has to be last, since it
#	wraps every widget defined before it.
#
#	zsh-autosuggestions and zsh-syntax-highlighting are deferred via
#	zsh-defer (S00): they execute once zle goes idle, after the first prompt
#	is drawn, instead of blocking startup. Queue order preserves the
#	load-bearing ordering above; you-should-use is cheap enough to load
#	eagerly.

if [ -z "${_DISABLE_ZSH_AUTOSUGGESTIONS}" ]; then
	[ -f "${ZSH_PLUGIN_DIR}/zsh-autosuggestions/zsh-autosuggestions.zsh" ] &&
		zsh-defer source "${ZSH_PLUGIN_DIR}/zsh-autosuggestions/zsh-autosuggestions.zsh"
fi

if [ -z "${_DISABLE_ZSH_YOU_SHOULD_USE}" ]; then
	[ -f "${ZSH_PLUGIN_DIR}/zsh-you-should-use/you-should-use.plugin.zsh" ] &&
		source "${ZSH_PLUGIN_DIR}/zsh-you-should-use/you-should-use.plugin.zsh"
fi

if [ -z "${_DISABLE_ZSH_SYNTAX_HIGHLIGHTING}" ]; then
	[ -f "${ZSH_PLUGIN_DIR}/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ] &&
		zsh-defer source "${ZSH_PLUGIN_DIR}/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
fi
